*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html,
body{
    width:100%;
    height:100%;
    overflow:hidden;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#05050a;
    color:white;
}


/* Background stars */

canvas{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    z-index:0;
}


/* Screens */

.screen{
    position:fixed;
    inset:0;

    z-index:1;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:18px;

    opacity:0;
    visibility:hidden;

    transition:opacity .9s ease;
}

.screen.active{
    opacity:1;
    visibility:visible;
}


/* Main content */

.content{
    width:100%;
    max-width:480px;
    height:100%;

    display:flex;
    flex-direction:column;

    align-items:center;
    justify-content:center;

    text-align:center;
}


/* Heading */

h1{
    font-size:clamp(35px,9vw,58px);
    line-height:1.08;

    margin:12px 0;
}

p{
    color:#d9d9df;

    line-height:1.55;

    font-size:15px;
}


/* Intro heart */

.mini-heart{
    font-size:52px;

    color:#ff66b3;

    text-shadow:
        0 0 15px #ff3d9d,
        0 0 35px #ff3d9d;

    animation:pulse 1.4s infinite;
}


/* Buttons */

button{
    margin-top:25px;

    border:0;

    border-radius:999px;

    padding:14px 28px;

    background:white;

    color:#111;

    font-size:16px;

    font-weight:700;

    cursor:pointer;

    box-shadow:
        0 8px 30px rgba(0,0,0,.5);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

button:active{
    transform:scale(.94);
}


/* Heart area */

#heart{
    position:relative;

    width:min(410px,96vw);

    height:min(500px,67vh);
}


/* Pink heart glow */

.heart-glow{
    position:absolute;

    width:205px;
    height:180px;

    left:50%;
    top:51%;

    transform:
        translate(-50%,-50%)
        rotate(-45deg);

    background:#ff3f9e;

    border-radius:
        50% 0 50% 50%;

    filter:blur(35px);

    opacity:.23;
}


.heart-glow::before,
.heart-glow::after{
    content:"";

    position:absolute;

    width:205px;
    height:180px;

    background:#ff3f9e;

    border-radius:50%;
}

.heart-glow::before{
    top:-92px;
    left:0;
}

.heart-glow::after{
    left:92px;
    top:0;
}


/* Heart centre */

.heart-core{
    position:absolute;

    left:50%;
    top:50%;

    transform:
        translate(-50%,-50%)
        rotate(-45deg);

    font-size:165px;

    color:#ff4ca5;

    opacity:.10;

    text-shadow:
        0 0 45px #ff4ca5;
}


/* Photo cards */

.card{
    position:absolute;

    left:50%;
    top:50%;

    width:88px;
    height:116px;

    padding:5px;

    background:white;

    border-radius:14px;

    overflow:hidden;

    opacity:0;

    transform:
        translate(-50%,-50%)
        scale(.15);

    box-shadow:
        0 0 18px #ff65b6,
        0 12px 30px rgba(0,0,0,.7);

    animation:
        photoIn .75s
        cubic-bezier(.2,.9,.2,1)
        forwards;
}


.card img{
    width:100%;
    height:100%;

    object-fit:cover;

    border-radius:9px;
}


/* Photo positions */

.card:nth-of-type(3){
    --x:-145px;
    --y:-135px;
    --r:-16deg;
    animation-delay:.08s;
}

.card:nth-of-type(4){
    --x:-60px;
    --y:-180px;
    --r:8deg;
    animation-delay:.18s;
}

.card:nth-of-type(5){
    --x:45px;
    --y:-175px;
    --r:-7deg;
    animation-delay:.28s;
}

.card:nth-of-type(6){
    --x:130px;
    --y:-112px;
    --r:15deg;
    animation-delay:.38s;
}

.card:nth-of-type(7){
    --x:-166px;
    --y:-18px;
    --r:9deg;
    animation-delay:.48s;
}

.card:nth-of-type(8){
    --x:-72px;
    --y:-48px;
    --r:-5deg;
    animation-delay:.58s;
}

.card:nth-of-type(9){
    --x:52px;
    --y:-42px;
    --r:8deg;
    animation-delay:.68s;
}

.card:nth-of-type(10){
    --x:148px;
    --y:-15px;
    --r:-10deg;
    animation-delay:.78s;
}

.card:nth-of-type(11){
    --x:-118px;
    --y:82px;
    --r:-12deg;
    animation-delay:.88s;
}

.card:nth-of-type(12){
    --x:2px;
    --y:96px;
    --r:5deg;
    animation-delay:.98s;
}


/* Photo animation */

@keyframes photoIn{

    to{

        opacity:1;

        transform:
            translate(
                calc(-50% + var(--x)),
                calc(-50% + var(--y))
            )
            rotate(var(--r))
            scale(1);
    }
}


/* Gallery text */

.gallery-caption{
    margin-top:-4px;

    font-size:13px;

    color:#aaa;
}


/* Final photo */

.final-frame{
    width:min(285px,76vw);

    aspect-ratio:3/4;

    padding:7px;

    background:white;

    border-radius:26px;

    box-shadow:
        0 0 35px #ff5eae,
        0 18px 55px rgba(0,0,0,.8);

    animation:
        finalIn 1.1s ease;
}


.final-frame img{
    width:100%;
    height:100%;

    object-fit:cover;

    border-radius:19px;
}


/* Final text */

.final-title{
    margin-top:22px;
}


.final-hearts{
    margin-top:18px;

    color:#ff69b4;

    letter-spacing:12px;

    text-shadow:
        0 0 18px #ff69b4;
}


/* Final animation */

@keyframes finalIn{

    from{
        opacity:0;

        transform:
            scale(.55)
            translateY(25px);
    }

    to{
        opacity:1;

        transform:
            scale(1)
            translateY(0);
    }
}


/* Intro heartbeat */

@keyframes pulse{

    50%{
        transform:scale(1.15);
    }
}


/* Mobile */

@media(max-height:700px){

    #heart{
        height:58vh;
    }

    .card{
        width:68px;
        height:90px;
    }

    .card:nth-of-type(3){
        --x:-112px;
        --y:-100px;
    }

    .card:nth-of-type(4){
        --x:-45px;
        --y:-133px;
    }

    .card:nth-of-type(5){
        --x:38px;
        --y:-130px;
    }

    .card:nth-of-type(6){
        --x:103px;
        --y:-82px;
    }

    .card:nth-of-type(7){
        --x:-126px;
        --y:-8px;
    }

    .card:nth-of-type(8){
        --x:-53px;
        --y:-33px;
    }

    .card:nth-of-type(9){
        --x:42px;
        --y:-29px;
    }

    .card:nth-of-type(10){
        --x:113px;
        --y:-3px;
    }

    .card:nth-of-type(11){
        --x:-88px;
        --y:59px;
    }

    .card:nth-of-type(12){
        --x:0;
        --y:70px;
    }
}