<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>For You ❤️</title>

    <!-- CSS file -->
    <link rel="stylesheet" href="style.css">
</head>


<body>

    <!-- Background stars -->
    <canvas id="stars"></canvas>


    <!-- =========================
         FIRST SCREEN
    ========================== -->

    <section class="screen active" id="intro">

        <div class="content">

            <div class="mini-heart">
                ♥
            </div>

            <h1>
                Something special<br>
                for you ❤️
            </h1>

            <p>
                Tap below and watch till the end.
            </p>

            <button id="openBtn">
                Open ❤️
            </button>

        </div>

    </section>



    <!-- =========================
         PHOTO HEART SCREEN
    ========================== -->

    <section class="screen" id="gallery">

        <div class="content">

            <div id="heart">

                <div class="heart-glow"></div>

                <div class="heart-core">
                    ♥
                </div>


                <!-- PHOTO 1 -->

                <div class="card">
                    <img src="assets/photo1.jpeg"
                         alt="Photo 1">
                </div>


                <!-- PHOTO 2 -->

                <div class="card">
                    <img src="assets/photo2.jpeg"
                         alt="Photo 2">
                </div>


                <!-- PHOTO 3 -->

                <div class="card">
                    <img src="assets/photo3.jpeg"
                         alt="Photo 3">
                </div>


                <!-- PHOTO 4 -->

                <div class="card">
                    <img src="assets/photo4.jpeg"
                         alt="Photo 4">
                </div>


                <!-- PHOTO 5 -->

                <div class="card">
                    <img src="assets/photo5.jpeg"
                         alt="Photo 5">
                </div>


                <!-- PHOTO 6 -->

                <div class="card">
                    <img src="assets/photo6.jpeg"
                         alt="Photo 6">
                </div>


                <!-- PHOTO 7 -->

                <div class="card">
                    <img src="assets/photo7.jpeg"
                         alt="Photo 7">
                </div>


                <!-- PHOTO 8 -->

                <div class="card">
                    <img src="assets/photo8.jpeg"
                         alt="Photo 8">
                </div>


                <!-- PHOTO 9 -->

                <div class="card">
                    <img src="assets/photo9.jpeg"
                         alt="Photo 9">
                </div>


                <!-- PHOTO 10 -->

                <div class="card">
                    <img src="assets/photo10.jpeg"
                         alt="Photo 10">
                </div>

            </div>


            <p class="gallery-caption">
                Every picture has a little piece of you ❤️
            </p>


            <button id="nextBtn">
                One more thing ❤️
            </button>

        </div>

    </section>



    <!-- =========================
         FINAL SCREEN
    ========================== -->

    <section class="screen" id="final">

        <div class="content final-content">


            <!-- YOUR PHOTO -->

            <div class="final-frame">

                <img src="assets/final.jpeg"
                     alt="My Photo">

            </div>


            <h1 class="final-title">
                Always ❤️
            </h1>


            <p>
                You make ordinary moments feel special.
            </p>


            <div class="final-hearts">
                ♥ ♥ ♥
            </div>

        </div>

    </section>



    <!-- JavaScript file -->

    <script src="script.js"></script>

</body>

</html>